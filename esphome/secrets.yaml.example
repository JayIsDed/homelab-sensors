# Copy to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never committed.

# WiFi
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP (for re-provisioning when WiFi is unavailable)
ap_password: "sensor-setup-password"

# Home Assistant API encryption key
# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "GENERATE_A_BASE64_KEY_HERE"

# OTA update password
ota_password: "your-ota-password"
